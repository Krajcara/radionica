# ── Radionica: podešavanja servera ─────────────────────────────────────────
# install.sh pravi .env iz ovog fajla. Pravi .env se nikad ne stavlja u git.

NODE_ENV=production

# Port na kom aplikacija radi
RADIONICA_PORT=8080

# Adresa na kojoj sluša (0.0.0.0 = sve mrežne kartice)
RADIONICA_HOST=0.0.0.0

# Fascikla sa bazom i rezervnim kopijama (podrazumevano: data/ u fascikli aplikacije)
# RADIONICA_DATA_DIR=/opt/radionica/data
